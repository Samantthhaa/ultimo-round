# Bot > Token no Discord Developer Portal. Nunca compartilhar ou fazer commit.
DISCORD_TOKEN=
# General Information > Application ID
DISCORD_APPLICATION_ID=
# true: aceita instalação em novos servidores; false: usa a lista de testes abaixo
DISCORD_PUBLIC=true
# Opcional no modo público; obrigatório apenas para testes restritos
DISCORD_GUILD_ID=
# Para testes restritos em outros servidores, acrescente os IDs separados por vírgulas:
# DISCORD_GUILD_IDS=123456789012345678,234567890123456789
